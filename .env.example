# Settings the dashboard needs. Do NOT put real values in this file.
# Real values are entered ONLY in Vercel → Project → Settings → Environment Variables.

# From the Salesforce External Client App (RevOps provides these securely)
SF_CLIENT_ID=CHANGE_ME
SF_CLIENT_SECRET=CHANGE_ME

# Commure's Salesforce login address (not a secret)
SF_LOGIN_URL=https://athelas.my.salesforce.com

# The dashboard's own web address, no trailing slash (e.g. https://sdr-inbound-dashboard.vercel.app)
APP_BASE_URL=CHANGE_ME

# A long random string (at least 32 characters) used to encrypt sign-in cookies
SESSION_SECRET=CHANGE_ME

# Optional: Salesforce API version
SF_API_VERSION=v62.0
